{
  "name": "vscode-pipelinesexplorer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "RiccardoCappello",
  "author": {
    "name": "Riccardo Cappello"
  },
  "license": "MIT",
  "homepage": "https://github.com/rcappello/PipelinesExplorer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcappello/PipelinesExplorer.git"
  },
  "bugs": {
    "url": "https://github.com/rcappello/PipelinesExplorer/issues"
  },
  "qna": "marketplace",
  "keywords": [
    "azure devops",
    "pipelines",
    "yaml",
    "ci/cd",
    "templates"
  ],
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Azure",
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "pipelinesexplorer.signInWithMicrosoft",
        "title": "%command.signInWithMicrosoft.title%"
      },
      {
        "command": "pipelinesexplorer.signInWithPat",
        "title": "%command.signInWithPat.title%"
      },
      {
        "command": "pipelinesexplorer.signOut",
        "title": "%command.signOut.title%"
      },
      {
        "command": "pipelinesexplorer.reset",
        "title": "%command.reset.title%"
      },
      {
        "command": "pipelinesexplorer.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "pipelinesexplorer.selectTenant",
        "title": "%command.selectTenant.title%",
        "icon": "$(organization)"
      },
      {
        "command": "pipelinesexplorer.showLogs",
        "title": "%command.showLogs.title%"
      },
      {
        "command": "pipelinesexplorer.linkWorkspace",
        "title": "%command.linkWorkspace.title%",
        "icon": "$(link)"
      },
      {
        "command": "pipelinesexplorer.unlinkWorkspace",
        "title": "%command.unlinkWorkspace.title%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "pipelinesexplorer.selectBranch",
        "title": "%command.selectBranch.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "pipelinesexplorer.openItem",
        "title": "%command.openItem.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pipelinesexplorer.refresh",
          "when": "view == pipelinesTree && pipelinesexplorer.signedIn",
          "group": "navigation"
        },
        {
          "command": "pipelinesexplorer.selectTenant",
          "when": "view == pipelinesTree && pipelinesexplorer.signedIn && pipelinesexplorer.signInKind == microsoft",
          "group": "navigation"
        },
        {
          "command": "pipelinesexplorer.signOut",
          "when": "view == pipelinesTree && pipelinesexplorer.signedIn"
        }
      ],
      "commandPalette": [
        {
          "command": "pipelinesexplorer.signOut",
          "when": "pipelinesexplorer.signedIn"
        },
        {
          "command": "pipelinesexplorer.reset"
        },
        {
          "command": "pipelinesexplorer.refresh",
          "when": "pipelinesexplorer.signedIn"
        },
        {
          "command": "pipelinesexplorer.selectTenant",
          "when": "pipelinesexplorer.signedIn && pipelinesexplorer.signInKind == microsoft"
        },
        {
          "command": "pipelinesexplorer.showLogs"
        },
        {
          "command": "pipelinesexplorer.linkWorkspace",
          "when": "false"
        },
        {
          "command": "pipelinesexplorer.unlinkWorkspace",
          "when": "false"
        },
        {
          "command": "pipelinesexplorer.selectBranch",
          "when": "false"
        },
        {
          "command": "pipelinesexplorer.openItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "pipelinesexplorer.linkWorkspace",
          "when": "view == pipelinesTree && viewItem == pipelinesexplorer.repository",
          "group": "inline"
        },
        {
          "command": "pipelinesexplorer.linkWorkspace",
          "when": "view == pipelinesTree && viewItem == pipelinesexplorer.repository"
        },
        {
          "command": "pipelinesexplorer.linkWorkspace",
          "when": "view == pipelinesTree && viewItem == pipelinesexplorer.repository.linked"
        },
        {
          "command": "pipelinesexplorer.unlinkWorkspace",
          "when": "view == pipelinesTree && viewItem == pipelinesexplorer.repository.linked",
          "group": "inline"
        },
        {
          "command": "pipelinesexplorer.selectBranch",
          "when": "view == pipelinesTree && (viewItem == pipelinesexplorer.repository || viewItem == pipelinesexplorer.repository.linked)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pipelinesTree",
        "contents": "%viewsWelcome.signIn.contents%",
        "when": "!pipelinesexplorer.signedIn"
      }
    ],
    "authentication": [
      {
        "id": "azuredevopspat",
        "label": "%authentication.azureDevOpsPat.label%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pipelines-explorer",
          "title": "%viewsContainer.pipelinesExplorer.title%",
          "icon": "media/pipelines-explorer.svg"
        }
      ]
    },
    "views": {
      "pipelines-explorer": [
        {
          "id": "pipelinesTree",
          "name": "%view.pipelinesTree.name%",
          "icon": "media/pipelines-explorer.svg",
          "contextualTitle": "%view.pipelinesTree.contextualTitle%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsce:package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.2",
    "eslint": "^9.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
