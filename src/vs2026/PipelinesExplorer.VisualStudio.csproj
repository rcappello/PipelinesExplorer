<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- VisualStudio.Extensibility VSIX outputs -->
    <RootNamespace>PipelinesExplorer.VisualStudio</RootNamespace>
    <AssemblyName>PipelinesExplorer.VisualStudio</AssemblyName>
    <PackageId>PipelinesExplorer.VisualStudio</PackageId>

    <!-- VSTHRD103 (sync Cancel on CTS) is the documented pattern for replacing in-flight loads. -->
    <NoWarn>$(NoWarn);VSTHRD103</NoWarn>
  </PropertyGroup>

  <!-- F5 inside Visual Studio: launch devenv.exe in the Experimental hive AND auto-deploy
       the VSIX there. Guarded by BuildingInsideVisualStudio so `dotnet build` from CLI
       (which does not implement VSIX deployment) is unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(BuildingInsideVisualStudio)' == 'true'">
    <DeployExtension>true</DeployExtension>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootSuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- VisualStudio.Extensibility SDK (out-of-process model, VS 17.14+ / VS 2026, .NET 10 ready) -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.*" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.*" />

    <!-- Azure DevOps client SDKs (used to talk to the same REST endpoints as the VS Code client) -->
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" Version="20.256.*" />
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" Version="20.256.*" />

    <!-- Microsoft Entra ID sign-in via MSAL with WAM broker on Windows -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.*" />
    <!--
      Cross-platform MSAL token cache (DPAPI on Windows). Without this the
      token cache is in-memory only and the user has to interactively sign
      in again every time Visual Studio is restarted. See:
      https://learn.microsoft.com/entra/msal/dotnet/how-to/token-cache-serialization?tabs=desktop
    -->
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.84.*" />

    <!-- JWT helper for extracting the `tid` claim from Microsoft Entra access tokens -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.*" />

    <!-- YAML parsing for pipeline analysis (templates / script tasks) -->
    <PackageReference Include="YamlDotNet" Version="17.1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remote UI XAML must be shipped as embedded resources, not WPF Pages -->
    <EmbeddedResource Include="ToolWindows\PipelinesToolWindowControl.xaml" />
    <Page Remove="ToolWindows\PipelinesToolWindowControl.xaml" />
    <EmbeddedResource Include="ToolWindows\TenantPickerDialog.xaml" />
    <Page Remove="ToolWindows\TenantPickerDialog.xaml" />
    <EmbeddedResource Include="ToolWindows\BranchPickerDialog.xaml" />
    <Page Remove="ToolWindows\BranchPickerDialog.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Localized UI strings. Default (English) lives in Strings.resx; localized
      satellite assemblies are produced from Strings.<culture>.resx files
      (it, fr, de, es, sv). The strongly-typed accessor is hand-written in
      Resources/Strings.cs (made `public` so the Remote UI XAML can reference
      it via clr-namespace bindings).
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled license shown by Extension Manager (Metadata.License = "LICENSE"). -->
    <Content Include="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
