<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
              xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Icon-only toolbar button. Shared between the header toolbar and
             the filter bar (Plan 001), hence declared at DataTemplate scope. -->
        <Style x:Key="IconToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static platform:EnvironmentColors.CommandBarHoverBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static platform:EnvironmentColors.CommandBarHoverOverSelectedIconBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static platform:EnvironmentColors.CommandBarMouseDownBackgroundBeginBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pull the right brushes/fonts for the current Visual Studio theme so the
             tool window adapts to Light/Dark/Blue/HC automatically. The Shell.15.0
             assembly is loaded by the VS process that hosts the Remote UI XAML;
             it is intentionally NOT a PackageReference of the (out-of-process)
             extension. -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platform:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
            <Setter Property="FontSize"   Value="{DynamicResource VsFont.EnvironmentFontSize}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"     Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground"     Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Setter Property="BorderBrush"    Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBorderBrushKey}}" />
            <Setter Property="CaretBrush"     Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
            <Setter Property="FontSize"   Value="{DynamicResource VsFont.EnvironmentFontSize}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBorderFocusedBrushKey}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBorderFocusedBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonDefaultBrushKey}}" />
            <Setter Property="Foreground"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonDefaultTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonBorderDefaultBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
            <Setter Property="FontSize"   Value="{DynamicResource VsFont.EnvironmentFontSize}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonHoverBrushKey}}" />
                    <Setter Property="Foreground"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonHoverTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonBorderHoverBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonPressedBrushKey}}" />
                    <Setter Property="Foreground"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonPressedTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonBorderPressedBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonDisabledBrushKey}}" />
                    <Setter Property="Foreground"  Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonDisabledTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:CommonControlsColors.ButtonBorderDisabledBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background"  Value="Transparent" />
            <Setter Property="Foreground"  Value="{DynamicResource {x:Static platform:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
            <Setter Property="FontSize"   Value="{DynamicResource VsFont.EnvironmentFontSize}" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platform:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <!-- Tighter rows mirror the SQL Server Object Explorer / VS Code tree
                 spacing instead of the very airy WPF default. -->
            <Setter Property="Padding" Value="2,1,2,1" />
        </Style>
    </DataTemplate.Resources>

    <Grid Margin="6"
          Background="{DynamicResource {x:Static platform:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static platform:EnvironmentColors.ToolWindowTextBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / connection status (visible when signed in) -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,6"
                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <!-- Right-aligned image buttons mirror the VS Code view/title icons.
                 The IconToolbarButton style is declared at DataTemplate scope so
                 it is also visible to the filter bar in row 1. -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconToolbarButton}"
                    ToolTip="{Binding Loc.Toolbar_SignOut_Tooltip}"
                    AutomationProperties.Name="{Binding Loc.Toolbar_SignOut_Tooltip}"
                    AutomationProperties.HelpText="{Binding Loc.Toolbar_SignOut_Tooltip}"
                    Command="{Binding SignOutCommand}">
                <vs:Image Source="KnownMonikers.Disconnect" Width="16" Height="16" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconToolbarButton}"
                    ToolTip="{Binding Loc.Toolbar_SwitchTenant_Tooltip}"
                    AutomationProperties.Name="{Binding Loc.Toolbar_SwitchTenant_Tooltip}"
                    AutomationProperties.HelpText="{Binding Loc.Toolbar_SwitchTenant_Tooltip}"
                    Visibility="{Binding IsMicrosoftSignIn, Converter={StaticResource BoolToVis}}"
                    Command="{Binding SelectTenantCommand}">
                <vs:Image Source="KnownMonikers.AzureActiveDirectory" Width="16" Height="16" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconToolbarButton}"
                    ToolTip="{Binding Loc.Toolbar_Refresh_Tooltip}"
                    AutomationProperties.Name="{Binding Loc.Toolbar_Refresh_Tooltip}"
                    AutomationProperties.HelpText="{Binding Loc.Toolbar_Refresh_Tooltip}"
                    Command="{Binding RefreshCommand}">
                <vs:Image Source="KnownMonikers.Refresh" Width="16" Height="16" />
            </Button>
            <TextBlock Text="{Binding ConnectionLabel}"
                       ToolTip="{Binding ConnectionTooltip}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold" />
        </DockPanel>

        <!-- Filter bar (visible when signed in) — Plan 001 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,6"
              Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0"
                     x:Name="FilterTextBox"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding Loc.Filter_Placeholder}"
                     AutomationProperties.Name="{Binding Loc.A11y_Filter_Name}"
                     AutomationProperties.HelpText="{Binding Loc.Filter_Placeholder}" />
            <!-- Placeholder overlay: WPF TextBox has no native watermark. Sits in the
                 same Grid cell as FilterTextBox, is transparent to hit-testing so
                 clicks reach the TextBox, and toggles visibility via a DataTrigger on
                 the VM's FilterText being empty (no ElementName binding needed, which
                 is safer under Remote UI). -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       IsHitTestVisible="False"
                       Text="{Binding Loc.Filter_Placeholder}"
                       Margin="8,0,4,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Opacity="0.55"
                       Foreground="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Row="0" Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource IconToolbarButton}"
                    ToolTip="{Binding Loc.Filter_Clear_Tooltip}"
                    AutomationProperties.Name="{Binding Loc.Filter_Clear_Tooltip}"
                    AutomationProperties.HelpText="{Binding Loc.Filter_Clear_Tooltip}"
                    Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ClearFilterCommand}">
                <vs:Image Source="KnownMonikers.Cancel" Width="16" Height="16" />
            </Button>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,4,0,0"
                       Text="{Binding FilterStatusText}"
                       ToolTip="{Binding Loc.Filter_LoadedScope_Tooltip}"
                       TextTrimming="CharacterEllipsis"
                       Opacity="0.75"
                       Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Welcome panel (visible when signed out) -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    Margin="0,4,0,8"
                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Loc.Welcome_SignInPrompt}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="{Binding Loc.Welcome_SignInWithMicrosoft}"
                        Margin="0,0,8,0"
                        Command="{Binding SignInWithMicrosoftCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding Loc.Welcome_PatHelp}"
                       Margin="0,12,0,4"
                       TextWrapping="Wrap" />
            <DockPanel HorizontalAlignment="Left">
                <Button DockPanel.Dock="Right"
                        Content="{Binding Loc.Welcome_SignInWithPat}"
                        Margin="6,0,0,0"
                        Command="{Binding SignInWithPatCommand}" />
                <!-- The PAT is shown in plain text while typing. Remote UI marshals
                     two-way text bindings across the out-of-process boundary on
                     focus loss, so an overlay-based masking trick (transparent
                     TextBox + bullet TextBlock bound to the VM) provides no
                     real-time feedback while typing. Plain text + cleared-on-
                     success (see PipelinesViewModel.SignInWithPatAsync) is the
                     pragmatic trade-off. A real WPF PasswordBox cannot be used
                     here because its Password is not a DependencyProperty and
                     therefore not bindable through Remote UI. -->
                <TextBox Width="260"
                         Text="{Binding PatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         Background="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBackgroundBrushKey}}"
                         Foreground="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         CaretBrush="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         ToolTip="{Binding Loc.Welcome_PatField_Tooltip}"
                         AutomationProperties.Name="{Binding Loc.A11y_PatField_Name}"
                         AutomationProperties.HelpText="{Binding Loc.Welcome_PatField_Tooltip}" />
            </DockPanel>
        </StackPanel>

        <!-- Add Azure DevOps organization panel (plan 002 phase D).
             Sits in the same Grid.Row as the welcome panel but is toggled by
             a distinct visibility binding; only ever visible under PAT sign-in. -->
        <Border x:Name="AddOrgPanel"
                Grid.Row="2"
                BorderBrush="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBorderBrushKey}}"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8"
                Visibility="{Binding IsAddOrgPanelOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Loc.AddOrg_Header}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding Loc.AddOrg_DeprecationNotice}"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Margin="0,0,0,8" />

                <!-- History suggestions -->
                <StackPanel Orientation="Vertical"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasOrgHistory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.AddOrg_HistoryLabel}"
                               Opacity="0.75"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding OrgHistory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="0,0,6,4"
                                        Padding="6,2"
                                        Command="{Binding DataContext.PickOrgFromHistoryCommand, ElementName=AddOrgPanel}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding DataContext.Loc.AddOrg_OrgFieldHelp, ElementName=AddOrgPanel}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Loc.AddOrg_OrgLabel}" Margin="0,0,0,2" />
                <TextBox Text="{Binding AddOrgNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBackgroundBrushKey}}"
                         Foreground="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         CaretBrush="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         ToolTip="{Binding Loc.AddOrg_OrgFieldHelp}"
                         AutomationProperties.HelpText="{Binding Loc.AddOrg_OrgFieldHelp}"
                         Margin="0,0,0,8" />

                <TextBlock Text="{Binding Loc.AddOrg_PatLabel}" Margin="0,0,0,2" />
                <!-- Same "plain-text PAT" trade-off as the welcome panel: Remote UI
                     cannot bind to WPF PasswordBox.Password (not a DependencyProperty). -->
                <TextBox Text="{Binding AddOrgPatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         Background="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxBackgroundBrushKey}}"
                         Foreground="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         CaretBrush="{DynamicResource {x:Static platform:CommonControlsColors.TextBoxTextBrushKey}}"
                         ToolTip="{Binding Loc.AddOrg_PatFieldHelp}"
                         AutomationProperties.Name="{Binding Loc.A11y_PatField_Name}"
                         AutomationProperties.HelpText="{Binding Loc.AddOrg_PatFieldHelp}"
                         Margin="0,0,0,8" />

                <!-- Inline error banner for this panel -->
                <Border Background="#33FF6961"
                        BorderBrush="#FFCC4F4F"
                        BorderThickness="1"
                        Padding="6"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasAddOrgError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding AddOrgErrorMessage}" TextWrapping="Wrap" />
                </Border>

                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{Binding Loc.AddOrg_Cancel}"
                            Margin="0,0,6,0"
                            Padding="10,3"
                            Command="{Binding CloseAddOrgPanelCommand}" />
                    <Button Content="{Binding Loc.AddOrg_Verify}"
                            Padding="10,3"
                            Command="{Binding VerifyAndAddOrgCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="3"
                Background="#33FF6961"
                BorderBrush="#FFCC4F4F"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Empty-state hint. Sits in the same Grid row as the tree so we
             don't need an extra row definition; visibility is mutex with the
             TreeView so they never overlap. Rendering the message outside the
             tree is important on narrow tool windows: the tree's internal
             ScrollViewer would otherwise force a horizontal scrollbar and
             eat the wrap. -->
        <TextBlock Grid.Row="4"
                   Margin="6,6,6,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Text="{Binding EmptyRootsMessage}"
                   Visibility="{Binding HasEmptyRootsMessage, Converter={StaticResource BoolToVis}}" />

        <!-- Tree -->
        <TreeView Grid.Row="4"
                  ItemsSource="{Binding Roots}"
                  AutomationProperties.Name="{Binding Loc.A11y_Tree_Name}"
                  Visibility="{Binding ShouldShowTree, Converter={StaticResource BoolToVis}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    <Setter Property="Visibility" Value="{Binding IsVisibleUnderFilter, Converter={StaticResource BoolToVis}}" />
                    <!-- Stretch each item so the ContentPresenter (which hosts the
                         DataTemplate) fills the TreeViewItem width. Without this,
                         a long Label inside the template only measures its own
                         intrinsic width, so DockPanel/Grid children never learn
                         the real available width and TextWrapping degrades to a
                         mid-word ellipsis. -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <DockPanel LastChildFill="True"
                                ContextMenuService.IsEnabled="{Binding HasContextMenu}">
                        <DockPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Loc.Context_Open}"
                                          Command="{Binding OpenCommand}"
                                          Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                <Separator Visibility="{Binding HasWorkspaceActions, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="{Binding Loc.Context_LinkWorkspace}"
                                          Command="{Binding LinkCommand}"
                                          Visibility="{Binding CanLinkWorkspace, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="{Binding Loc.Context_UnlinkWorkspace}"
                                          Command="{Binding UnlinkCommand}"
                                          Visibility="{Binding CanUnlinkWorkspace, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="{Binding Loc.Context_SelectBranch}"
                                          Command="{Binding SelectBranchCommand}"
                                          Visibility="{Binding CanSelectBranch, Converter={StaticResource BoolToVis}}" />
                            </ContextMenu>
                        </DockPanel.ContextMenu>
                        <vs:Image DockPanel.Dock="Left"
                                  Source="{Binding IconMoniker}"
                                  Width="16" Height="16"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Description}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.7" />
                        <TextBlock Text="{Binding Label}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</DataTemplate>
