<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </DataTemplate.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / connection status (visible when signed in) -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,6"
                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right"
                    Content="Sign out"
                    Margin="6,0,0,0"
                    Padding="8,2"
                    Command="{Binding SignOutCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Margin="6,0,0,0"
                    Padding="8,2"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Text="{Binding ConnectionLabel}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontWeight="SemiBold" />
        </DockPanel>

        <!-- Welcome panel (visible when signed out) -->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Margin="0,4,0,8"
                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Sign in to Azure DevOps to browse pipelines."
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="Sign in with Microsoft"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Command="{Binding SignInWithMicrosoftCommand}" />
            </WrapPanel>
            <TextBlock Text="Or paste an Azure DevOps personal access token (Build Read, Code Read):"
                       Margin="0,12,0,4"
                       TextWrapping="Wrap" />
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Sign in with PAT"
                        Padding="10,4"
                        Margin="6,0,0,0"
                        Command="{Binding SignInWithPatCommand}" />
                <TextBox Text="{Binding PatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" />
            </DockPanel>
        </StackPanel>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Background="#33FF6961"
                BorderBrush="#FFCC4F4F"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Tree -->
        <TreeView Grid.Row="3"
                  ItemsSource="{Binding Roots}"
                  Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}"
                  BorderThickness="0">
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open"
                                          Command="{Binding OpenCommand}" />
                                <Separator />
                                <MenuItem Header="Link workspace folder\u2026"
                                          Command="{Binding LinkCommand}" />
                                <MenuItem Header="Unlink workspace folder"
                                          Command="{Binding UnlinkCommand}" />
                                <MenuItem Header="Select branch\u2026"
                                          Command="{Binding SelectBranchCommand}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Description}"
                                   Margin="6,0,0,0"
                                   Opacity="0.7" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</DataTemplate>
